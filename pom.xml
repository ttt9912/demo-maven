<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>ch.ttt</groupId>
    <artifactId>demo-maven</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <!-- Those are primarly used for documentation (mvn site) -->
    <name>demo-maven</name>
    <description>Demo Spring Boot / Kotlin service</description>
    <url>https://${github.owner}.github.io/${github.repo}/</url>
    <licenses>
        <license>
            <name>TODO: your licence (e.g. Apache-2.0, or Proprietary)</name>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>ttt</id>
            <name>Thomas</name>
        </developer>
    </developers>
    <scm>
        <url>https://github.com/${github.owner}/${github.repo}</url>
        <connection>scm:git:https://github.com/${github.owner}/${github.repo}.git</connection>
        <developerConnection>scm:git:git@github.com:${github.owner}/${github.repo}.git</developerConnection>
        <tag>HEAD</tag>
    </scm>
    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/${github.owner}/${github.repo}/issues</url>
    </issueManagement>
    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/${github.owner}/${github.repo}/actions</url>
    </ciManagement>
    <!-- -->

    <properties>
        <java.version>25</java.version>
        <kotlin.version>2.3.21</kotlin.version>

        <!-- Build-quality plugins -->
        <spotless-maven-plugin.version>3.8.0</spotless-maven-plugin.version>
        <maven.min.version>3.9.0</maven.min.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <detekt-maven-plugin.version>1.23.8</detekt-maven-plugin.version>
        <dependency-check-maven.version>13.0.0</dependency-check-maven.version>

        <!-- Quality gates -->
        <jacoco.minimum.line.coverage>0.7</jacoco.minimum.line.coverage>
        <owasp.fail.cvss>7</owasp.fail.cvss>

        <!-- For documentation fields above -->
        <github.owner>ttt9912</github.owner>
        <github.repo>demo-maven</github.repo>

        <!-- Site (documentation) -->
        <maven-site-plugin.version>3.21.0</maven-site-plugin.version>
        <maven-project-info-reports-plugin.version>3.9.0</maven-project-info-reports-plugin.version>
        <dokka-maven-plugin.version>2.2.0</dokka-maven-plugin.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-reflect</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>${maven-site-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- ============================================================
                 validate phase
                 ============================================================ -->
            <!-- check minimum versions, banned dependencies, dependency convergence, or no SNAPSHOT dependencies in releases -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-rules</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[${maven.min.version},)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[${java.version},)</version>
                                </requireJavaVersion>
                                <bannedDependencies>
                                    <excludes>
                                        <!-- JUnit 4 / vintage: use JUnit 5+ only -->
                                        <exclude>junit:junit</exclude>
                                        <exclude>org.junit.vintage:*</exclude>
                                        <!-- Log4j 1.x is end-of-life -->
                                        <exclude>log4j:log4j</exclude>
                                        <!-- javax.* Servlet API: Spring Boot 4 is Jakarta EE -->
                                        <exclude>javax.servlet:javax.servlet-api</exclude>
                                    </excludes>
                                </bannedDependencies>
                                <dependencyConvergence/>
                                <requireReleaseDeps>
                                    <message>No SNAPSHOT dependencies are allowed in a release.</message>
                                    <onlyWhenRelease>true</onlyWhenRelease>
                                </requireReleaseDeps>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Spotless: ktlint formatting + license header check for Kotlin sources.
                 Fix locally with: ./mvnw spotless:apply -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <configuration>
                    <kotlin>
                        <includes>
                            <include>src/main/kotlin/**/*.kt</include>
                            <include>src/test/kotlin/**/*.kt</include>
                        </includes>
                        <ktlint/>
                        <!-- Adds license header to every class file (execute mvn spotless:apply) -->
                        <licenseHeader>
                            <content>
                                /* Copyright (c) $YEAR ttt. All rights reserved. */
                            </content>
                        </licenseHeader>
                    </kotlin>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Git metadata -> target/classes/git.properties (exposed by /actuator/info if Actuator is added).
                 Version, the 'revision' execution and the git.properties output are preconfigured
                 by spring-boot-starter-parent; it runs in the 'initialize' phase. -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <configuration>
                    <!-- Don't break builds from a source zip / CI checkout without .git -->
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    <offline>true</offline>
                </configuration>
            </plugin>

            <!-- ============================================================
                 compile phase
                 ============================================================ -->
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <configuration>
                    <args>
                        <arg>-Xjsr305=strict</arg>
                        <arg>-Xannotation-default-target=param-property</arg>
                    </args>
                    <compilerPlugins>
                        <plugin>spring</plugin>
                    </compilerPlugins>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- ============================================================
                 package phase
                 ============================================================ -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- ============================================================
                 verify phase: coverage + static analysis
                 (declared after failsafe so they run after the integration tests)
                 ============================================================ -->
            <!-- Integration tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- JaCoCo: one agent covers both unit (Surefire) and integration (Failsafe) tests,
                 because both plugins pick up the ${argLine} property set by prepare-agent.
                 If you ever configure <argLine> yourself, include @{argLine} in it.
                 Report: target/site/jacoco/index.html -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <configuration>
                    <excludes>
                        <!-- Spring Boot main() entry point -->
                        <exclude>**/*ApplicationKt.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <!-- Build fails if below this ration (0.7) -->
                                            <minimum>${jacoco.minimum.line.coverage}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- detekt: Kotlin static analysis. Uses detekt's default rule set.
                 To customise: ./mvnw detekt:generate-config, then add
                 <config>detekt.yml</config> and <buildUponDefaultConfig>true</buildUponDefaultConfig>.
                 Reports: target/detekt.html, target/detekt.xml -->
            <plugin>
                <groupId>com.github.ozsie</groupId>
                <artifactId>detekt-maven-plugin</artifactId>
                <version>${detekt-maven-plugin.version}</version>
                <configuration>
                    <input>${project.basedir}/src/main/kotlin,${project.basedir}/src/test/kotlin</input>
                    <report>
                        <report>html:${project.build.directory}/site/detekt.html</report>
                        <report>xml:${project.build.directory}/detekt.xml</report>
                    </report>
                </configuration>
                <executions>
                    <execution>
                        <id>detekt-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- ============================================================
                 site lifecycle
                 ============================================================ -->

            <!-- Dokka: Kotlin API docs (maven-javadoc-plugin ignores Kotlin sources).
                 Runs at pre-site and writes into target/site/dokka, linked from the site menu. -->
            <plugin>
                <groupId>org.jetbrains.dokka</groupId>
                <artifactId>dokka-maven-plugin</artifactId>
                <version>${dokka-maven-plugin.version}</version>
                <configuration>
                    <outputDir>${project.build.directory}/site/dokka</outputDir>
                </configuration>
                <executions>
                    <execution>
                        <id>dokka-site</id>
                        <phase>pre-site</phase>
                        <goals>
                            <goal>dokka</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Reports rendered by `mvn site`. Run `./mvnw verify site` so test, coverage and
         detekt results exist before the site is built. Output: target/site/index.html -->
    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-project-info-reports-plugin</artifactId>
                <version>${maven-project-info-reports-plugin.version}</version>
                <reportSets>
                    <reportSet>
                        <!-- 'index' is left out: src/site/markdown/index.md is the home page -->
                        <reports>
                            <report>summary</report>
                            <report>team</report>
                            <report>licenses</report>
                            <report>scm</report>
                            <report>issue-management</report>
                            <report>ci-management</report>
                            <report>dependencies</report>
                            <report>plugins</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>

            <!-- Unit + integration test results; re-uses the reports from `verify`
                 instead of running the tests again -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <reportSets>
                    <reportSet>
                        <reports>
                            <report>report-only</report>
                            <report>failsafe-report-only</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>

            <!-- Coverage report from target/jacoco.exec written during `verify` -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <configuration>
                    <excludes>
                        <exclude>**/*ApplicationKt.class</exclude>
                    </excludes>
                </configuration>
                <reportSets>
                    <reportSet>
                        <reports>
                            <report>report</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>
        </plugins>
    </reporting>

    <profiles>
        <!-- OWASP Dependency-Check: scans dependencies against the NVD for known CVEs.
             Kept out of the default build because it downloads/updates a large vulnerability
             database (slow, needs network).

             Run with: ./mvnw verify -Powasp

             Get a free NVD API key (https://nvd.nist.gov/developers/request-an-api-key)
             and export it as NVD_API_KEY, otherwise updates are extremely slow.

             Report: target/dependency-check-report.html

             In CI: run this check as a separate nightly or weekly job, and cache
             `~/.m2/repository/org/owasp/dependency-check-data` between runs.
             -->
        <profile>
            <id>owasp</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency-check-maven.version}</version>
                        <configuration>
                            <!-- Free Api Key. Without it download is really slow.
                            `export NVD_API_KEY=your-key-here` -->
                            <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                            <!-- Fails the build for any dependency with a **CVSS** score of 7 or higher-->
                            <failBuildOnCVSS>${owasp.fail.cvss}</failBuildOnCVSS>
                            <skipTestScope>true</skipTestScope>
                            <!-- Sonatype OSS Index now requires credentials; NVD alone is enough here -->
                            <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                            <!-- Accept false positives here once you have reviewed them -->
                            <!-- <suppressionFiles><suppressionFile>owasp-suppressions.xml</suppressionFile></suppressionFiles> -->
                        </configuration>
                        <executions>
                            <execution>
                                <id>owasp-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <!-- Target of `mvn deploy`: GitHub Packages (Maven registry of this repo).
         Uploads the fat JAR + POM (+ checksums). SNAPSHOT and release versions use the
         same URL; a release version can only be published once.
         Credentials: a <server> with id "github" in settings.xml. In GitHub Actions,
         setup-java generates it from GITHUB_TOKEN (see .github/workflows/publish.yml). -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/${github.owner}/${github.repo}</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/${github.owner}/${github.repo}</url>
        </snapshotRepository>
    </distributionManagement>
</project>
